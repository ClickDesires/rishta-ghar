# Copy this file to .env and fill in your Supabase project's values
# (Supabase dashboard → Project Settings → API).
# Both values are safe to ship in the app: the database privacy rules in supabase/schema.sql do the protecting.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
